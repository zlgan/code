.container {
  min-height: 100vh;
  background-color: var(--background-color);
  display: flex;
  flex-direction: column;
}

.search-section {
  background-color: #fff;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.search-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  background-color: var(--background-color);
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
}

.search-input icon {
  margin-right: 16rpx;
  color: var(--text-color-secondary);
}

.search-input input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
}

.filter-btn {
  margin-left: 30rpx;
  font-size: 28rpx;
  color: var(--text-color);
  position: relative;
}

.filter-dot {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  width: 12rpx;
  height: 12rpx;
  background-color: var(--primary-color);
  border-radius: 50%;
}

.tab-bar {
  display: flex;
  background-color: #fff;
  padding: 0 30rpx;
  position: fixed;
  top: 112rpx;
  left: 0;
  right: 0;
  z-index: 100;
  border-bottom: 2rpx solid var(--border-color);
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  position: relative;
  color: var(--text-color);
}

.tab.active {
  color: var(--primary-color);
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background-color: var(--primary-color);
  border-radius: 2rpx;
}

.tab text {
  font-size: 28rpx;
}

.tab .count {
  font-size: 24rpx;
  margin-top: 8rpx;
  color: var(--text-color-secondary);
}

.document-list {
  flex: 1;
  margin-top: 224rpx;
  padding: 30rpx;
}

.list-item {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.1);
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.left {
  display: flex;
  align-items: center;
}

.order-no {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-right: 16rpx;
}

.type {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 4rpx;
}

.type.inbound {
  color: var(--primary-color);
  background-color: var(--primary-color-light);
}

.type.outbound {
  color: #ff9800;
  background-color: rgba(255, 152, 0, 0.1);
}

.date {
  font-size: 24rpx;
  color: var(--text-color-secondary);
}

.item-content {
  border-top: 2rpx solid var(--border-color);
  padding-top: 20rpx;
}

.product-info {
  margin-bottom: 16rpx;
}

.product-name {
  font-size: 28rpx;
  color: var(--text-color);
  margin-right: 16rpx;
}

.product-code {
  font-size: 24rpx;
  color: var(--text-color-secondary);
}

.party-info {
  margin-bottom: 16rpx;
}

.party-info .label {
  font-size: 26rpx;
  color: var(--text-color-secondary);
}

.party-info .value {
  font-size: 26rpx;
  color: var(--text-color);
}

.quantity-info {
  display: flex;
  justify-content: space-between;
}

.quantity, .amount {
  display: flex;
  align-items: center;
}

.quantity .label,
.amount .label {
  font-size: 26rpx;
  color: var(--text-color-secondary);
  margin-right: 8rpx;
}

.quantity .value {
  font-size: 26rpx;
  color: var(--text-color);
}

.amount .value {
  font-size: 26rpx;
  color: var(--primary-color);
  font-weight: bold;
}

.loading,
.no-more {
  text-align: center;
  padding: 30rpx 0;
}

.loading text,
.no-more text {
  font-size: 24rpx;
  color: var(--text-color-secondary);
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty image {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 30rpx;
}

.empty text {
  font-size: 28rpx;
  color: var(--text-color-secondary);
}

/* 筛选弹窗 */
.filter-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 900;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}

.filter-mask.show {
  opacity: 1;
  visibility: visible;
}

.filter-popup {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  width: 600rpx;
  background-color: #fff;
  z-index: 999;
  transform: translateX(100%);
  transition: all 0.3s;
  display: flex;
  flex-direction: column;
}

.filter-popup.show {
  transform: translateX(0);
}

.filter-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 2rpx solid var(--border-color);
}

.filter-header text {
  font-size: 32rpx;
  font-weight: bold;
}

.close-btn {
  font-size: 40rpx;
  color: var(--text-color-secondary);
  padding: 10rpx;
}

.filter-content {
  flex: 1;
  padding: 30rpx;
  overflow-y: auto;
}

.filter-section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 28rpx;
  color: var(--text-color);
  margin-bottom: 20rpx;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
}

.tag {
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  background-color: var(--background-color);
  color: var(--text-color);
  font-size: 24rpx;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
}

.tag.active {
  background-color: var(--primary-color);
  color: #fff;
}

.date-range {
  display: flex;
  align-items: center;
}

.date-picker {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 20rpx;
  background-color: var(--background-color);
  border-radius: 8rpx;
  font-size: 24rpx;
  color: var(--text-color);
}

.separator {
  margin: 0 20rpx;
  color: var(--text-color-secondary);
}

.filter-footer {
  padding: 20rpx 30rpx;
  border-top: 2rpx solid var(--border-color);
  display: flex;
  justify-content: space-between;
}

.filter-footer .btn {
  flex: 1;
  margin: 0 10rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  border-radius: 44rpx;
}

.btn-default {
  background-color: var(--background-color);
  color: var(--text-color);
}

.btn-primary {
  background-color: var(--primary-color);
  color: #fff;
}