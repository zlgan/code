<![CDATA[<!-- pages/profile/company/index.wxml -->
<view class="container">
  <form bindsubmit="handleSubmit">
    <view class="form-group">
      <view class="form-item">
        <text class="label">公司名称</text>
        <input class="input" name="name" value="{{company.name}}" placeholder="请输入公司名称" />
      </view>
      <view class="form-item">
        <text class="label">联系人</text>
        <input class="input" name="contact" value="{{company.contact}}" placeholder="请输入联系人姓名" />
      </view>
      <view class="form-item">
        <text class="label">联系电话</text>
        <input class="input" name="phone" value="{{company.phone}}" type="number" placeholder="请输入联系电话" />
      </view>
      <view class="form-item">
        <text class="label">电子邮箱</text>
        <input class="input" name="email" value="{{company.email}}" type="text" placeholder="请输入电子邮箱" />
      </view>
      <view class="form-item">
        <text class="label">公司地址</text>
        <input class="input" name="address" value="{{company.address}}" placeholder="请输入公司地址" />
      </view>
    </view>

    <view class="form-group">
      <view class="form-item">
        <text class="label">备注信息</text>
        <textarea class="textarea" name="remark" value="{{company.remark}}" placeholder="请输入备注信息" maxlength="200"></textarea>
        <view class="word-count">{{company.remark.length || 0}}/200</view>
      </view>
    </view>

    <view class="button-group">
      <button class="submit-btn" form-type="submit" type="primary">保存</button>
    </view>
  </form>
</view>]]>