<view class="container">
  <view class="detail-card card">
    <view class="card-header">
      <view class="order-info">
        <text class="order-no">{{record.orderNo}}</text>
        <text class="type">{{record.type}}</text>
      </view>
      <text class="date">{{record.date}}</text>
    </view>

    <view class="card-content">
      <view class="info-section">
        <text class="section-title">产品信息</text>
        <view class="info-item">
          <text class="label">产品名称</text>
          <text class="value">{{record.product.name}}</text>
        </view>
        <view class="info-item">
          <text class="label">产品编号</text>
          <text class="value">{{record.product.code}}</text>
        </view>
        <view class="info-item">
          <text class="label">出库数量</text>
          <text class="value">{{record.quantity}} {{record.product.unit}}</text>
        </view>
        <view class="info-item">
          <text class="label">出库单价</text>
          <text class="value">¥{{record.price}}</text>
        </view>
        <view class="info-item">
          <text class="label">出库金额</text>
          <text class="value amount">¥{{record.amount}}</text>
        </view>
      </view>

      <view class="info-section" wx:if="{{record.customer}}">
        <text class="section-title">客户信息</text>
        <view class="info-item">
          <text class="label">客户名称</text>
          <text class="value">{{record.customer}}</text>
        </view>
      </view>

      <view class="info-section" wx:if="{{record.remark}}">
        <text class="section-title">备注信息</text>
        <view class="remark">{{record.remark}}</view>
      </view>
    </view>

    <view class="card-footer">
      <text class="create-time">创建时间：{{createTimeStr}}</text>
    </view>
  </view>

  <view class="footer-buttons">
    <button class="btn btn-default" bindtap="onPrint">打印单据</button>
    <button class="btn btn-primary" bindtap="onShare">分享</button>
  </view>
</view>