<view class="container">
  <form bindsubmit="submitForm">
    <view class="form-group card">
      <view class="form-item">
        <text class="form-label">单据号</text>
        <input class="form-input" disabled value="{{formData.orderNo}}" />
      </view>

      <view class="form-item">
        <text class="form-label required">出库类型</text>
        <picker mode="selector" range="{{outboundTypes}}" bindchange="onTypeChange" value="{{typeIndex}}">
          <view class="form-picker">{{formData.type || '请选择出库类型'}}</view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label required">出库日期</text>
        <picker mode="date" bindchange="onDateChange" value="{{formData.date}}">
          <view class="form-picker">{{formData.date || '请选择出库日期'}}</view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label">客户</text>
        <input class="form-input" name="customer" placeholder="请输入客户名称" value="{{formData.customer}}" />
      </view>
    </view>

    <view class="form-group card">
      <view class="section-title">产品信息</view>
      
      <view class="form-item">
        <text class="form-label required">产品名称</text>
        <picker mode="selector" range="{{products}}" range-key="name" bindchange="onProductChange" value="{{productIndex}}">
          <view class="form-picker">{{formData.product.name || '请选择产品'}}</view>
        </picker>
      </view>

      <view class="product-info" wx:if="{{formData.product.id}}">
        <view class="info-item">
          <text class="label">当前库存</text>
          <text class="value">{{formData.product.stock}} {{formData.product.unit}}</text>
        </view>
        <view class="info-item">
          <text class="label">建议售价</text>
          <text class="value">¥{{formData.product.outboundPrice}}</text>
        </view>
      </view>

      <view class="form-item">
        <text class="form-label required">出库数量</text>
        <input class="form-input" type="digit" name="quantity" placeholder="请输入出库数量" value="{{formData.quantity}}" bindinput="onQuantityInput" />
      </view>

      <view class="form-item">
        <text class="form-label required">出库单价</text>
        <input class="form-input" type="digit" name="price" placeholder="请输入出库单价" value="{{formData.price}}" bindinput="onPriceInput" />
      </view>

      <view class="amount-info">
        <text class="label">出库金额</text>
        <text class="value">¥{{totalAmount}}</text>
      </view>
    </view>

    <view class="form-group card">
      <view class="form-item">
        <text class="form-label">备注</text>
        <textarea class="form-textarea" name="remark" placeholder="请输入备注信息" value="{{formData.remark}}" />
      </view>
    </view>

    <view class="footer-buttons">
      <button class="btn btn-primary" form-type="submit">保存出库</button>
    </view>
  </form>
</view>